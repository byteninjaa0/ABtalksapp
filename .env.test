# ---------------------------------------------------------------------------
# Plan 195 — the test environment.
#
# This file is loaded by `scripts/test-env/dev.ts`, which injects every value
# below as a real process env var before spawning `next dev`. Next does not
# overwrite a variable that is already set, so these WIN over `.env.local` and
# `.env` — which is the whole point, because both of those point DATABASE_URL at
# a Neon host holding real users.
#
# Two properties this file must keep:
#   1. DATABASE_URL is loopback. `scripts/test-env/guard.ts` refuses to run
#      against anything else, and the test console refuses to render.
#   2. There are NO mail credentials. The test environment must be incapable of
#      sending email to a real person. Do not add BREVO_API_KEY here.
# ---------------------------------------------------------------------------

# --- Database: local Postgres 17, created by `npm run test:env:setup` ---------
# The host is spelled `localhost`, not `127.0.0.1`, and that is load-bearing:
# `prisma/seed-program-test-users.ts` recognises a safe database by looking for
# the literal substring "localhost" and refuses to run otherwise. Both spellings
# are loopback and both pass this project's own guard, so the one the existing
# seeds already accept is the one to use.
DATABASE_URL="postgresql://abtalks_test:abtalks_test@localhost:5432/abtalks_test"
DIRECT_URL="postgresql://abtalks_test:abtalks_test@localhost:5432/abtalks_test"

# --- Auth --------------------------------------------------------------------
# Test-only secret. Not shared with any deployed environment, so a session
# minted here is worthless anywhere else.
AUTH_SECRET="test-env-secret-plan-195-do-not-use-anywhere-else"

# Password sign-in for both doors (plan 154). This is what the test console uses
# to switch identity, so the environment does not work without both.
ENABLE_EMAIL_LOGIN=true
ENABLE_RECRUITER_AUTH=true
ENABLE_RECRUITER_SIGNUP=true

# Google is deliberately NOT configured. With AUTH_GOOGLE_ID/SECRET unset the
# provider is not registered at all (see auth.ts), so no test run can bounce out
# to a real Google consent screen.

# Seed list only — `seed-admin.ts` reads it to create the first grant. Nothing
# at runtime grants admin from this (plan 169).
ADMIN_EMAILS="admin@abtalks.dev"

# --- Gates: everything open --------------------------------------------------
# The launch gate and the hiring-path hide are both "on unless false", so both
# have to be spelled out or most of the product redirects to the one-pager.
LANDING_ONE_PAGER=false
HIDE_GET_HIRED=false

# --- Tracks: all four, plus every cohort ------------------------------------
ENABLE_CLAUDE_CHALLENGE=true
ENABLE_CODING_PRACTICE=true
HACKATHON_PREVIEW=true
ENABLE_DATABRICKS=true
ENABLE_DS_ARCHITECT=true
ENABLE_POWERBI=true
ENABLE_SNOWFLAKE=true
ENABLE_DATABRICKS_AI=true
ENABLE_LANGCHAIN=true

# Day locks off, so a test can open any challenge day without waiting 60 days.
# Fixtures still set real day numbers when a test needs the locking behaviour —
# flip this to false for those.
BYPASS_DAY_LOCKS=true

# --- Hire desk ---------------------------------------------------------------
HIRE_PRO_PREVIEW=true
HIRE_VIRTUAL_CANDIDATES=true
# Open the candidate pool to every cohort, and accept candidates at any day
# count. Without these the desk renders but finds nobody.
HIRE_OPEN_COHORT_IDS=all
HIRE_CHALLENGE_POOL=0

# --- OTP ---------------------------------------------------------------------
# No SMS is sent; this fixed code verifies. `isOtpVerificationRequired()` is
# already false when NODE_ENV=development, so this is the belt-and-braces half.
OTP_DEV_BYPASS=true
OTP_DEV_CODE=1234

# --- The test console --------------------------------------------------------
# One of three gates. The other two — NODE_ENV not production, and a loopback
# DATABASE_URL — are not configurable, and the DB-host check is the one that
# actually protects a deployed environment.
ENABLE_TEST_CONSOLE=true

# --- Per-host cookie jars ----------------------------------------------------
# The session-collision fix. Cookies in this app are host-only and *.localhost
# resolves to 127.0.0.1, so each host below is an independent cookie jar and can
# hold its own logged-in identity at the same time as all the others.
#
# Next 16 blocks /_next/* from any origin that is not plain localhost, which
# would leave these hosts serving un-hydrated pages. `next.config.ts` already
# folds ALLOWED_DEV_ORIGINS into `allowedDevOrigins`, so listing them here needs
# no code change.
ALLOWED_DEV_ORIGINS="localhost,127.0.0.1,candidate.localhost,recruiter.localhost,admin.localhost,program.localhost,hackathon.localhost,workshop.localhost"

# --- Chatbot / AI: off -------------------------------------------------------
# No API keys, so nothing in a test run can spend money on a real model call.
ENABLE_CHATBOT=false
