{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "abtalks-test-env",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "test:env:dev"
      ],
      "port": 3100
    },
    {
      "name": "abtalks-interview-latency",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "cross-env",
        "ENABLE_INTERVIEW_LATENCY_PROBE=true",
        "next",
        "dev"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "abtalks-interview-testdb",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:interview"
      ],
      "port": 3000
    },
    {
      "name": "abtalks-plain-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "abtalks-dev-databricks-ai",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "cross-env",
        "ENABLE_DATABRICKS_AI=true",
        "next",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "abtalks-attach-3000",
      "url": "http://localhost:3000",
      "port": 3000
    }
  ]
}
