# ── Google Analytics 4 (T-252) ──────────────────────────────────────────────
# Marks the runtime as the real production deploy. Set to `production` ONLY on
# the production Vercel deploy — leave unset in .env.local AND on preview
# deploys, since Vercel previews run with NODE_ENV=production and would
# otherwise start loading GA. The GA4 loader early-returns unless this equals
# `production`.
# NEXT_PUBLIC_APP_ENV=production

# GA4 measurement ID for the "ABTalks Production" property under GA account
# "ABTalksOnAI" (14-month retention, IP anonymization platform-enforced).
# The loader is a no-op when this is unset. Public because gtag.js needs it in
# the browser; it is not a secret.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-KJCDR1DZ0F

# Chatbot
# ENABLE_CHATBOT=true

# Virtual candidates: an empty search offers to source the requirement.
# Needs the VirtualCandidate tables. Apply the migration with
#   prisma db execute --file prisma/migrations/20260826120000_virtual_candidates/migration.sql
#   prisma migrate resolve --applied 20260826120000_virtual_candidates
# (`prisma migrate deploy` cannot be used on this database — see
#  docs/project-context.md on the leftover 20260813000000_general_interview.)
# HIRE_VIRTUAL_CANDIDATES=true

# Recruiter email OTP login/register. Unset (default) keeps them closed.
# ENABLE_RECRUITER_AUTH=true

# Plan 194: recruiter SIGN-UP, separately from sign-in. Unset means "follow
# ENABLE_RECRUITER_AUTH". Set to false when accounts are created FOR people
# rather than BY them: the register panel, /talent/register and
# /recruiter-onboarding all close and both register actions refuse, while
# password and emailed-code SIGN-IN keep working for the accounts an admin
# made — which ENABLE_RECRUITER_AUTH=false would have broken, since
# authorizePassword refuses a recruiter when that flag is off.
# ENABLE_RECRUITER_SIGNUP=false

# Plan 191, TEMPORARY. The launch one-pager is the home page and the recruiter
# product is hidden. ON by default — unset means on. Setting it to "false"
# lifts both halves at once, with no code change and no redeploy of code:
#   - / renders the full marketing landing again (LandingPage)
#   - /hire, /talent and /recruiter-onboarding stop redirecting to /
# Admins are never blocked from those routes, and /admin/hire is unaffected.
# Read by isLaunchOnePagerEnabled() in src/lib/feature-flags.ts AND, by hand,
# by middleware.ts (which cannot import @/lib/* — Edge bundle limit).
# LANDING_ONE_PAGER=false

# TEMPORARY: hides the dashboard's "Get hired" stage, the open-to-work toggle
# it carries, and the job board at /jobs. On unless set to false, which
# restores all three with no code change. See docs/launch-gate.md.
# HIDE_GET_HIRED=false

# Plan 196: learners trained who are not registered on the platform yet. When
# set (> 0), the first /admin card reads "Learners Trained" = registrations +
# this number, and /admin/students leads with the same figure. Candidate,
# filtered, exported and recruiter-facing counts never include it. Server-only.
# LEARNERS_TRAINED_BASELINE=

# Plan 192, TEMPORARY. The two preview links that open the gated platform.
# While LANDING_ONE_PAGER is on, the public sees only the launch page; these
# let the team in. Set each to a long random value, e.g.
#   openssl rand -hex 24
# Then the links are:
#   https://app.klymb.ai/?preview=<PREVIEW_TOKEN_CANDIDATE>   candidate side
#   https://app.klymb.ai/?preview=<PREVIEW_TOKEN_RECRUITER>   recruiter side
# Opening one sets an httpOnly cookie for 30 days on that browser and strips
# the token from the URL. One side never opens the other, ?preview=off clears
# both, and changing a value here revokes every link and cookie made from it.
# Leaving one unset means that side has no link at all.
#
# Plan 193: the links now SIGN YOU IN. Opening one lands on /preview/enter and
# authenticates that browser as a dedicated preview account —
# preview-candidate@klymb.ai or preview-recruiter@klymb.ai — so the whole side
# works with no Google sign-in and no recruiter OTP. The recruiter account is
# provisioned like a real one, credits included. Both are created on first use.
#
# That makes each link a credential in a URL: anyone holding it is signed in,
# with no second factor, and the recruiter one can see the candidate pipeline.
# Treat them like passwords. Rotating a value here revokes the link, and the
# provider refuses entirely when LANDING_ONE_PAGER=false, so turning the launch
# page off also closes the door. An existing session is never overwritten.
# PREVIEW_TOKEN_CANDIDATE=
# PREVIEW_TOKEN_RECRUITER=

# Plan 154: password + emailed-code sign-in next to Google. Candidate /login
# gets "Email code | Password" (a code to a new address creates the account),
# recruiters get a Password option, /settings/security opens, and Google links
# to an existing email-created account. Unset (default) = Google only.
# ENABLE_EMAIL_LOGIN=true

# Local only (ignored when NODE_ENV=production): lets admin accounts — which
# are Google-only everywhere else — sign in with a password, so the seeded
# admin@abtalks.dev / admin works under `next dev`. It no longer adds a
# separate "Dev Login" form; seeded users sign in through the Password tab.
# ENABLE_DEV_AUTH=true

# Databricks cohort at /program/databricks. Unset/false 404s the route and
# hides the Prep Kit card. Set to true in Vercel to launch.
# ENABLE_DATABRICKS=true

# Data Solutions Architect cohort at /program/ds-architect. Unset/false 404s
# the route and hides the Prep Kit card. Set to true in Vercel to launch.
# ENABLE_DS_ARCHITECT=true

# Power BI & Analytics cohort at /program/powerbi. Unset/false 404s the route
# and hides the Prep Kit card. Set to true in Vercel to launch.
# ENABLE_POWERBI=true

# Snowflake Data & AI Engineering cohort at /program/snowflake. Unset/false
# 404s the route and hides the Prep Kit card. Set to true in Vercel to launch.
# ENABLE_SNOWFLAKE=true

# 15-day Databricks Data & AI Engineering cohort at /program/databricks-ai
# (separate from the 31-day ENABLE_DATABRICKS cohort). Unset/false 404s the
# route and hides the Prep Kit card. Set to true in Vercel to launch.
# ENABLE_DATABRICKS_AI=true

# LangChain & LangGraph cohort at /program/langchain. Unset/false 404s the
# route and hides the Prep Kit card. Set to true in Vercel to launch.
# ENABLE_LANGCHAIN=true

# Coding practice (DSA) at /practice, plan 186. Unset/false 404s the pages,
# hides the dashboard card and makes Run / Submit refuse. Set to true to launch.
# ENABLE_CODING_PRACTICE=true

# Judge0 code execution for coding practice. SERVER-ONLY: never prefix these
# with NEXT_PUBLIC_. The browser only ever calls our own /api/practice/run.
# JUDGE0_URL is the instance base URL. Unset = every Run and Submit answers
# "unavailable" without a network call. The public instance needs no key.
# JUDGE0_URL=https://ce.judge0.com
# Only for an instance that needs a key. Sent as X-RapidAPI-Key when the URL
# host ends in rapidapi.com, otherwise as X-Auth-Token.
# JUDGE0_API_KEY=

# Google Gemini (résumé parser, interview agent, site chatbot, /hire Scout brief)
GEMINI_API_KEY=your_gemini_api_key_here
# Optional model for /hire live strip ticks + search filters (default gemini-3.5-flash-lite).
# HIRE_BRIEF_GEMINI_MODEL=gemini-3.5-flash-lite

# Anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Canonical host (plan 189) ───────────────────────────────────────
# Production is `https://app.klymb.ai`. abtalks.in / www.abtalks.in are kept
# alive as a path-preserving 308 to it, configured on the Vercel domain — NOT
# in next.config.ts redirects(), which match paths and not hosts.
#
# Set BOTH on the production deploy, to the same value and with no trailing
# slash. `NEXT_PUBLIC_APP_URL` is inlined at BUILD time, so changing it needs a
# redeploy, not a restart. Roughly 14 modules fall back to a hard-coded host
# when it is unset, so an unset value degrades quietly rather than erroring.
#
# NEXT_PUBLIC_APP_URL=https://app.klymb.ai
# AUTH_URL=https://app.klymb.ai
#
# Locally both are optional — `trustHost` is on and dev sign-in navigates
# same-origin so LAN/phone testing works.
#
# NEVER set a cookie `domain` for this app. klymb.ai runs a SEPARATE
# application, so a `.klymb.ai` cookie reaches it and can be set by any
# *.klymb.ai subdomain. All cookies here are host-only; see auth.config.ts and
# docs/plans/189-domain-migration-app-klymb-ai.md §6-A.

# NextAuth / application secret
AUTH_SECRET=your_auth_secret_here

# ------------------------------------------------------------ voice interview
# One key covers all three legs: speech-to-text, text-to-speech, and the model
# that reads the answers. Without it the interview falls back to the mock judge,
# which scores every candidate the same.
OPENAI_API_KEY=your_openai_api_key_here
ENABLE_INTERVIEW_VOICE=true

# openai | groq | gemini | anthropic | mock. Unset auto-detects from the keys
# present, preferring OpenAI. NEVER leave this on `mock` outside local UI work —
# a mock-graded interview is not a real result.
INTERVIEW_LLM_PROVIDER=openai

# Optional overrides.
# OPENAI_INTERVIEW_MODEL=gpt-4o          # the judge
# OPENAI_INTERVIEW_REPORT_MODEL=gpt-4o   # the report narrative
# INTERVIEW_STT_MODEL=gpt-4o-transcribe
# INTERVIEW_TTS_MODEL=gpt-4o-mini-tts

# ------------------------------------------------------------ résumé parsing (plan 154)
# Every résumé parse (/register, /profile, admin import) uses OpenAI. Same key
# as interviews, DIFFERENT model: OpenAI limits are per model, so résumés never
# spend the interview judge's gpt-4o budget. Never set the résumé model to gpt-4o.
RESUME_PARSER_PROVIDER=openai            # openai | gemini (fallback only)
# RESUME_OPENAI_API_KEY=                 # optional dedicated key; falls back to OPENAI_API_KEY
RESUME_OPENAI_MODEL=gpt-4.1-mini         # chosen by eval — plan 154 §2d
# RESUME_OPENAI_MAX_OUTPUT_TOKENS=4096
# Admin bulk import worker. The TPM budget is deliberately half of
# gpt-4.1-mini's 200k so live /register parses and the chatbot keep headroom.
# RESUME_IMPORT_CONCURRENCY=4
# RESUME_IMPORT_TPM_BUDGET=100000
# RESUME_IMPORT_RPM_BUDGET=200
# RESUME_IMPORT_MAX_ATTEMPTS=6
# RESUME_IMPORT_MIN_REMAINING_RATIO=0.3
# Only for a model missing from the built-in price table (USD per 1M tokens).
# RESUME_OPENAI_PRICE_IN=
# RESUME_OPENAI_PRICE_OUT=
# The worker continues itself by calling its own deployment (VERCEL_URL) with
# CRON_SECRET. Override only if that URL is not reachable.
# RESUME_IMPORT_SELF_URL=
# Plan 171: claim-and-complete emails for imported students. Off unless "true".
# The invite goes out as soon as a student is registered; reminders and the
# after-claim emails go with the daily résumé-import cron (09:00 IST).
# IMPORT_OUTREACH_ENABLED=false
# Signs the /claim/<token> links. At least 32 bytes: openssl rand -base64 48
# IMPORT_CLAIM_SECRET=
# Brevo transactional webhook → /api/webhooks/brevo?secret=<this> (≥ 16 chars).
# Hard bounces / blocks / spam reports stop that student's emails.
# BREVO_WEBHOOK_SECRET=
# INTERVIEW_TTS_VOICE=ash
GROQ_API_KEY=your_groq_api_key_here
# ---------------------------------------------------------------------------
# Help Assistant chatbot (src/app/api/chat)
# ---------------------------------------------------------------------------
# All four provider keys above are SERVER-side only — never NEXT_PUBLIC_*.
#
# Generation runs OpenAI -> Gemini -> Groq -> Anthropic, stopping at the first
# that answers. OpenAI leads because it is the only rung on a paid plan; the
# other three are free tiers and are there for resilience.
#
# OPENAI_API_KEY now does DOUBLE DUTY: primary generation AND the retrieval
# embeddings. Removing it drops generation to Gemini and degrades retrieval to
# lexical-only — the chatbot keeps working, less well, in both respects.
#
# Cost, measured: about $0.002 per answered message on gpt-4.1-mini
# (~4.6k context tokens in, ~200 out), so roughly 450 messages per $1. Query
# embeddings are a rounding error on top. NOTE that this key is shared with the
# AI Cohort voice interview (INTERVIEW_LLM_PROVIDER), which is far more
# expensive per use — check that budget before assuming headroom here.
#
# Model overrides (all optional, defaults shown):
# CHATBOT_OPENAI_MODEL=gpt-4.1-mini
# CHATBOT_GEMINI_MODEL=gemini-flash-latest
# CHATBOT_GROQ_MODEL=openai/gpt-oss-120b
# CHATBOT_ANTHROPIC_MODEL=claude-haiku-4-5-20251001
#
# Verify provider health, models, latency and failover at any time:
#   npm run check:chatbot
#
# Logs each retrieval's verdict and confidence. Local debugging only.
# CHATBOT_DEBUG=false
#
# Refreshing knowledge:
#   npm run ingest:site   # crawl public routes -> knowledge/generated (dev server must be running)
#   npm run kb:embed      # embed changed chunks -> knowledge/embeddings.json (costs OpenAI credit)
#   npm run test:chatbot  # retrieval regression suite (no API keys needed)

# Transactional mail — Brevo. Without this, sendEmail skips silently:
# recruiter sign-in codes, hire alerts, the contact form and DSAR notices
# all go nowhere. In development the recruiter code is printed to the log
# instead (see features/recruiter-auth/otp.ts).
BREVO_API_KEY=
FROM_EMAIL=team@abtalks.in
# Plan 185: mail kinds sent through ABT-Mailer (our SES sender) instead of
# Brevo, comma-separated, e.g. "profile.viewed,job.alert.match". Empty = all
# Brevo. The secret is ABT-Mailer's TRANSACTIONAL_API_HMAC_SECRET.
# ABT_MAILER_URL=https://abt-mailer.vercel.app
# ABT_MAILER_HMAC_SECRET=
# EMAIL_VIA_ABT_KINDS=
# Plan 186: entries may be "*" (every kind) or "prefix.*". Kinds matched here
# stay on Brevo even when EMAIL_VIA_ABT_KINDS matches them, e.g. "recruiter.otp".
# EMAIL_KEEP_ON_BREVO_KINDS=
# FROM_NAME=ABTalks
# REPLY_TO_EMAIL=team@abtalks.in

# ── Résumé file storage (plan 106) ───────────────────────────────────────────
# Vercel Blob, provisioned by the team under THESE names — not the SDK default
# BLOB_READ_WRITE_TOKEN / BLOB_STORE_ID. `features/resume/storage.ts` passes the
# token explicitly on every call; do not rename these.
#
# The store MUST be created with PRIVATE access: résumés carry a phone number,
# an email and a home city, so every file is written with access:'private' and a
# PUBLIC store rejects that outright.
#
# Unset, or pointing at a public store, is NOT fatal — uploads are still parsed,
# scored and merged into the profile; the original PDF simply is not retained
# and the "View file" link does not appear. Check the logs for
# "[resume] the blob store is PUBLIC" if files are silently not being kept.
resume2_STORE_ID=
resume2_READ_WRITE_TOKEN=

# Profile avatars on /profile. A separate PUBLIC Vercel Blob store — do not
# reuse resume2_*. Unset: the pencil does not render; the rest of /profile is
# unaffected. A private store will reject every public write.
avatar_STORE_ID=
avatar_READ_WRITE_TOKEN=

# ── Observability: Sentry + structured logs (T-259) ──────────────────────────
# All optional. Unset, the app behaves exactly as before: Sentry stays inert and
# the logger still writes structured JSON to stdout.
#
# The server DSN. Set this in Vercel PRODUCTION only — Sentry is gated on
# NEXT_PUBLIC_APP_ENV=production (not NODE_ENV, which is "production" on every
# preview deploy too; same reasoning as src/lib/env.ts).
SENTRY_DSN=

# The browser DSN. Same project, but it ships to the client, so it must be the
# NEXT_PUBLIC_ one. Safe to expose — a DSN only permits writing events.
NEXT_PUBLIC_SENTRY_DSN=

# Performance sampling. 0.1 = 10% of transactions. Defaults to 0.1 if unset.
# SENTRY_TRACES_SAMPLE_RATE=0.1
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1

# Exercise Sentry from a local machine or a preview deploy. Server-side only,
# and never set this in production — it is what the gate exists to avoid.
# SENTRY_FORCE_ENABLE=1

# Log verbosity: trace | debug | info | warn | error | fatal.
# Defaults to "info" in production and "debug" everywhere else.
# LOG_LEVEL=info

# Overrides the `service` field on every log line. Defaults to "abtalks-web".
# OTEL_SERVICE_NAME=abtalks-web

# Dashboard greeting sky — dev only (ignored in production).
# Freeze the sky + greeting at an IST time "HH:mm", e.g. 06:15 sunrise,
# 12:00 noon, 18:20 sunset, 22:00 night. "cycle" loops the whole day in 15s.
# Leave empty to follow the clock.
DASHBOARD_SKY_TIME=

# Dashboard — dev only (ignored in production). "1" shows the enrolled
# Build skills layout (60-day grid, streak box, Continue learning) with
# sample progress when you have no track. Read-only.
DASHBOARD_PREVIEW_ENROLLED=

# Dashboard — dev only. "1" previews a 100% complete profile (read-only).
DASHBOARD_PREVIEW_PROFILE_COMPLETE=
